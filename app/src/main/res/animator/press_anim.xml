<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:duration="0" android:valueTo="0.82" android:propertyName="scaleX" />
            <objectAnimator android:duration="0" android:valueTo="0.82" android:propertyName="scaleY" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="@android:integer/config_mediumAnimTime" android:valueTo="1.0" android:propertyName="scaleX" />
            <objectAnimator android:duration="@android:integer/config_mediumAnimTime" android:valueTo="1.0" android:propertyName="scaleY" />
        </set>
    </item>
</selector>
