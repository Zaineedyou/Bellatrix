<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16.0dp"
        android:paddingBottom="26.0dp">

        <!-- One Bellatrix card: the action and its output live in the same row. -->
        <com.bellatrixos.widgets.cards.UISettingsCardCollapse
            android:id="@+id/coding_agents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="1.5999756dp"
            app:ui_icon_src="@drawable/img_app_terminal"
            app:ui_subtitle="@string/linux_output_more"
            app:ui_title="@string/agents_title">

            <TextView
                android:id="@+id/coding_agents_log_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:minLines="3"
                android:text="@string/linux_process_log_empty"
                android:textColor="@color/text_muted"
                android:textSize="12.0sp" />
        </com.bellatrixos.widgets.cards.UISettingsCardCollapse>
    </LinearLayout>
</ScrollView>
