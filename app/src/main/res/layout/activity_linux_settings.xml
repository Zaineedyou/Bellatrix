<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1B26">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/linux_settings_title"
            android:textColor="#C0CAF5"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/linux_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#C0CAF5"
            android:textSize="14sp" />

        <Button
            android:id="@+id/linux_install"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/linux_install" />

        <Button
            android:id="@+id/linux_retry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/linux_retry_setup" />

        <Button
            android:id="@+id/linux_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/linux_cancel_setup" />

        <Button
            android:id="@+id/linux_gpu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/linux_gpu_title" />

        <Button
            android:id="@+id/linux_terminal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/linux_open_terminal" />

        <Button
            android:id="@+id/linux_remove"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/linux_remove" />

    </LinearLayout>
</ScrollView>
