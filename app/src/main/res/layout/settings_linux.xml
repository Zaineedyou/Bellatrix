<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16.0dp"
        android:paddingBottom="26.0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6.0dp"
            android:layout_marginBottom="10.0dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="56.0dp"
                android:layout_height="56.0dp"
                android:background="@drawable/shape_rounded_corner_14"
                android:contentDescription="@string/linux_settings_title"
                android:foreground="@drawable/shape_rounded_corner_border_6"
                android:scaleType="centerCrop"
                android:src="@drawable/img_app_terminal" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16.0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/linux_settings_title"
                    android:textColor="@color/text_default"
                    android:textSize="20.0sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/linux_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?colorPrimary"
                    android:textSize="14.0sp" />
            </LinearLayout>
        </LinearLayout>

        <com.bellatrixos.widgets.cards.UISettingsCardProgressBar
            android:id="@+id/linux_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="1.5999756dp"
            android:visibility="gone"
            app:ui_icon_src="@drawable/img_nav_update_20"
            app:ui_subtitle="@string/linux_step_download"
            app:ui_title="@string/linux_progress_title" />

        <TextView
            android:id="@+id/linux_stages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18.0dp"
            android:layout_marginTop="10.0dp"
            android:layout_marginBottom="4.0dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_default"
            android:textSize="13.0sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/linux_progress_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18.0dp"
            android:layout_marginBottom="10.0dp"
            android:text="@string/linux_progress_background"
            android:textColor="@color/text_muted"
            android:textSize="12.0sp"
            android:visibility="gone" />

        <com.bellatrixos.widgets.cards.UISettingsCard
            android:id="@+id/linux_install"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="1.5999756dp"
            app:ui_icon_src="@drawable/img_nav_update_20"
            app:ui_subtitle="@string/linux_settings_install_subtitle"
            app:ui_title="@string/linux_install" />

        <com.bellatrixos.widgets.cards.UISettingsCard
            android:id="@+id/linux_retry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="1.5999756dp"
            app:ui_icon_src="@drawable/img_nav_update_20"
            app:ui_subtitle="@string/linux_retry_setup"
            app:ui_title="@string/linux_retry" />

        <com.bellatrixos.widgets.cards.UISettingsCard
            android:id="@+id/linux_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="1.5999756dp"
            app:ui_icon_src="@drawable/app_title_ic_close_16"
            app:ui_subtitle="@string/linux_cancel_setup"
            app:ui_title="@string/linux_cancel_setup" />

        <com.bellatrixos.widgets.cards.UISettingsCardCollapse
            android:id="@+id/linux_install_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="1.5999756dp"
            android:visibility="gone"
            app:ui_icon_src="@drawable/ic_info_26_regular"
            app:ui_subtitle="@string/linux_output_more"
            app:ui_title="@string/linux_output">

            <TextView
                android:id="@+id/linux_install_log_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_muted"
                android:textSize="12.0sp" />
        </com.bellatrixos.widgets.cards.UISettingsCardCollapse>

        <com.bellatrixos.widgets.cards.UISettingsCard
            android:id="@+id/linux_gpu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="1.5999756dp"
            app:ui_icon_src="@drawable/ic_info_26_regular"
            app:ui_subtitle="@string/linux_settings_gpu_subtitle"
            app:ui_title="@string/linux_gpu_title" />

        <com.bellatrixos.widgets.cards.UISettingsCardCollapse
            android:id="@+id/linux_gpu_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="1.5999756dp"
            android:visibility="gone"
            app:ui_icon_src="@drawable/ic_info_26_regular"
            app:ui_subtitle="@string/linux_output_more"
            app:ui_title="@string/linux_output">

            <TextView
                android:id="@+id/linux_gpu_log_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_muted"
                android:textSize="12.0sp" />
        </com.bellatrixos.widgets.cards.UISettingsCardCollapse>

        <com.bellatrixos.widgets.cards.UISettingsCard
            android:id="@+id/linux_terminal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="1.5999756dp"
            app:ui_icon_src="@drawable/img_app_terminal"
            app:ui_subtitle="@string/linux_settings_terminal_subtitle"
            app:ui_title="@string/linux_open_terminal" />

        <!-- Stays inside launcher Settings: install/download coding agents here. -->
        <com.bellatrixos.widgets.cards.UISettingsCard
            android:id="@+id/linux_agents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="1.5999756dp"
            app:ui_icon_src="@drawable/img_app_terminal"
            app:ui_subtitle="@string/settings_agents_install"
            app:ui_title="@string/start_filter_coding_agents" />

        <com.bellatrixos.widgets.cards.UISettingsCard
            android:id="@+id/linux_remove"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="1.5999756dp"
            app:ui_icon_src="@drawable/ic_delete_26_regular"
            app:ui_subtitle="@string/linux_settings_remove_subtitle"
            app:ui_title="@string/linux_remove" />

        <!-- Terminal-style box: always at the very bottom, showing Linux process output. -->
        <LinearLayout
            android:id="@+id/linux_process_log_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18.0dp"
            android:background="@drawable/linux_terminal_box"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/linux_process_log"
                android:textColor="#6EE787"
                android:textSize="11.0sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/linux_process_log_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:maxLines="10"
                android:scrollbars="vertical"
                android:text="@string/linux_process_log_empty"
                android:textColor="#D6FFD9"
                android:textSize="11.0sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
