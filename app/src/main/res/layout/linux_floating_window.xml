<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale">

    <com.bellatrixos.widgets.FloatingLayout
        android:id="@+id/linux_floating_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/app_dialog_bg_dark"
        android:backgroundTintMode="src_atop"
        android:clickable="true"
        android:elevation="5dp"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.bellatrixos.widgets.UITitleBar
                android:id="@id/titleBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ui_title="@string/linux_terminal_window" />

            <FrameLayout
                android:id="@+id/linux_content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#1a1b26">

                <FrameLayout
                    android:id="@+id/linux_keybar_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </com.bellatrixos.widgets.FloatingLayout>
</FrameLayout>
