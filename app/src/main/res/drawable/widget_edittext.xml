<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/widget_edittext_active_base" />
    <item>
        <layer-list>
            <item android:left="5.0dp" android:top="5.0dp" android:right="5.0dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/edit_text_border_bottom" />
                </shape>
            </item>
            <item android:bottom="1.0dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/widget_input_bg_active" />
                    <corners android:radius="5.0dp" />
                    <stroke android:width="1.0dp" android:color="@color/widget_input_bg_active_border" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
