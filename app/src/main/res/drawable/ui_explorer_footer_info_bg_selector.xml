<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_item_bg_pressed" />
            <stroke android:width="1.0dp" android:color="@color/explorer_files_info_btn_border" />
        </shape>
    </item>
    <item android:state_pressed="true" android:drawable="@drawable/widget_btn_secondary_active" />
    <item android:drawable="@drawable/widget_btn_secondary_hover" android:state_hovered="true" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
