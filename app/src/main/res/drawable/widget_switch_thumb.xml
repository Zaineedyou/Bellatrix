<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:dither="true" android:visible="true" android:shape="rectangle" android:useLevel="false">
            <solid android:color="?colorPrimary" />
            <corners android:radius="16.0dp" />
            <size android:height="24.0dp" android:width="24.0dp" />
            <stroke android:width="10.0dp" android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:dither="true" android:visible="true" android:shape="rectangle" android:useLevel="false">
            <solid android:color="@color/color_scheme_ui" />
            <corners android:radius="16.0dp" />
            <size android:height="24.0dp" android:width="24.0dp" />
            <stroke android:width="10.0dp" android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:state_checked="false">
        <shape android:dither="true" android:visible="true" android:shape="rectangle" android:useLevel="false">
            <solid android:color="@color/widget_switch_unchecked_thumb" />
            <corners android:radius="16.0dp" />
            <size android:height="24.0dp" android:width="24.0dp" />
            <stroke android:width="10.0dp" android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
