<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:dither="true" android:visible="true" android:shape="rectangle" android:useLevel="false">
            <corners android:radius="26.0dp" />
            <size android:height="24.0dp" android:width="46.0dp" />
            <stroke android:width="1.0dp" android:color="?colorPrimary" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:dither="true" android:visible="true" android:shape="rectangle" android:useLevel="false">
            <solid android:color="?colorPrimary" />
            <corners android:radius="26.0dp" />
            <size android:height="24.0dp" android:width="46.0dp" />
        </shape>
    </item>
    <item android:state_checked="false">
        <shape android:dither="true" android:visible="true" android:shape="rectangle" android:useLevel="false">
            <solid android:color="#1a888888" />
            <corners android:radius="26.0dp" />
            <size android:height="24.0dp" android:width="46.0dp" />
            <stroke android:width="1.0dp" android:color="@color/widget_switch_unchecked_border" />
        </shape>
    </item>
</selector>
