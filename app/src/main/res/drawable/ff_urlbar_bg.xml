<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ff_field_focus" />
            <corners android:radius="6.0dp" />
            <stroke android:width="2.0dp" android:color="@color/ff_accent" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ff_field_hover" />
            <corners android:radius="6.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ff_field" />
            <corners android:radius="6.0dp" />
        </shape>
    </item>
</selector>
