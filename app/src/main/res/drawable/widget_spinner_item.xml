<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:state_activated="true">
        <layer-list>
            <item android:drawable="@drawable/widget_spinner_item_alpha" />
            <item android:gravity="center_vertical" android:height="9.0dp" android:width="3.0dp" android:left="6.0dp" android:right="6.0dp">
                <shape android:shape="rectangle">
                    <solid android:color="?colorPrimary" />
                    <corners android:radius="12.0dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_activated="true" android:state_hovered="true">
        <layer-list>
            <item android:drawable="@drawable/widget_spinner_item_alpha" />
            <item android:gravity="center_vertical" android:height="14.0dp" android:width="3.0dp" android:left="6.0dp" android:right="6.0dp">
                <shape android:shape="rectangle">
                    <solid android:color="?colorPrimary" />
                    <corners android:radius="12.0dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true" android:drawable="@drawable/widget_spinner_item_alpha" />
    <item android:drawable="@drawable/widget_spinner_item_base" android:state_hovered="true" />
    <item android:state_activated="true">
        <layer-list>
            <item android:drawable="@drawable/widget_spinner_item_base" />
            <item android:gravity="center_vertical" android:height="14.0dp" android:width="3.0dp" android:left="6.0dp" android:right="6.0dp">
                <shape android:shape="rectangle">
                    <solid android:color="?colorPrimary" />
                    <corners android:radius="12.0dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
